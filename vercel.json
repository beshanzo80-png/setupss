{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index.ts" },
    { "source": "/sitemap-(.*).xml", "destination": "/api/index.ts" },
    { "source": "/robots.txt", "destination": "/api/index.ts" },
    { "source": "/feed.json", "destination": "/api/index.ts" },
    { "source": "/rss.xml", "destination": "/api/index.ts" },
    { "source": "/setupss-indexnow-key-2026.txt", "destination": "/api/index.ts" },
    { "source": "/api", "destination": "/api/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/auth", "destination": "/api/index.ts" },
    { "source": "/auth/(.*)", "destination": "/api/index.ts" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
